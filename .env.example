# ==============================================================================
# Text-to-SQL Analyst AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' to configure live LLM providers.
# In Demo Mode (offline), no API keys are required!

# ------------------------------------------------------------------------------
# Google Gemini Configuration (Live Mode)
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# OpenAI Configuration (Live Mode)
# ------------------------------------------------------------------------------
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Execution Safety Limits (Optional defaults)
# ------------------------------------------------------------------------------
SQL_QUERY_TIMEOUT_SEC=5.0
SQL_MAX_ROWS_LIMIT=500
